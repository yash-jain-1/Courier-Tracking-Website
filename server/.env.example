# Copy to server/.env and fill in real values. Never commit server/.env.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/
MONGO_DB_NAME=test
PORT=5000
JWT_SECRET=<long random string>
REGISTER_SECRET=<long random string>
# Optional: comma-separated list overriding the default allowed origins
# CORS_ORIGINS=http://localhost:3000,https://indoreparcel.in
